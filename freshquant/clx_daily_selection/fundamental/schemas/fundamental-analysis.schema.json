{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freshquant.local/schemas/fundamental-analysis.v1.json",
  "title": "fundamental-analysis",
  "type": "object",
  "required": [
    "schemaVersion", "symbol", "name", "tier", "asOf", "oneLinePositioning",
    "sixDimensionScores", "compositeGrade", "keyMetrics", "risks", "advantages",
    "problems", "sections", "evidenceGrade", "evidenceIds", "generatedBy", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "fundamental-analysis.v1" },
    "symbol": { "type": "string" },
    "name": { "type": "string" },
    "tier": { "const": "deep" },
    "asOf": { "type": "string" },
    "quoteDate": { "type": "string" },
    "financialReportDate": { "type": "string" },
    "oneLinePositioning": { "type": "string" },
    "sixDimensionScores": { "$ref": "#/definitions/sixDimensions" },
    "compositeGrade": { "$ref": "#/definitions/grade" },
    "keyMetrics": { "type": "object" },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "text"],
        "properties": {
          "level": { "enum": ["high", "medium", "low"] },
          "text": { "type": "string" }
        }
      }
    },
    "advantages": { "type": "array", "items": { "type": "string" } },
    "problems": { "type": "array", "items": { "type": "string" } },
    "sections": { "type": "object" },
    "evidenceGrade": { "enum": ["A", "B", "C", "D"] },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "evidenceSourceSha256": { "type": "string" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string" }
  },
  "definitions": {
    "grade": {
      "type": "string",
      "enum": ["strong", "good", "neutral", "watch", "weak", "evidence_gap"]
    },
    "sixDimensions": {
      "type": "object",
      "required": ["business_quality", "growth", "profitability", "balance_sheet", "industry_capability", "valuation"],
      "additionalProperties": {
        "type": "object",
        "required": ["grade", "rationale"],
        "properties": {
          "grade": { "$ref": "#/definitions/grade" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
